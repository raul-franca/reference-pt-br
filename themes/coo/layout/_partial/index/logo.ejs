<%
// Define o tema conforme o contexto
let logoTheme = 'light'; // padrão para páginas que não são a inicial
if (typeof theme !== 'undefined') {
    logoTheme = theme; // usa o tema recebido, se houver
} else if (is_home()) {
    logoTheme = 'dark'; // tema escuro para a página inicial (texto claro em fundo escuro)
}

// Define as classes de cor conforme o tema
let iconColorClass, textColorClass, gradientClass, zipColorClass;
if (logoTheme === 'dark') {
    // Para fundos escuros (página inicial)
    iconColorClass = 'text-white';
    textColorClass = 'text-slate-100';
    gradientClass = 'bg-gradient-to-r from-white to-cyan-100 bg-clip-text text-transparent';
    zipColorClass = 'text-cyan-300';
} else {
    // Para fundos claros (páginas de detalhe, footer)
    iconColorClass = 'text-emerald-600 dark:text-emerald-400';
    textColorClass = 'text-slate-800 dark:text-slate-200';
    gradientClass = 'bg-gradient-to-r from-slate-800 to-slate-600 bg-clip-text text-transparent dark:from-slate-200 dark:to-slate-400';
    zipColorClass = 'text-emerald-600 dark:text-emerald-400';
}
%>
<a href="/" title="cheatsheets.zip - Referência rápida e cheat sheets para desenvolvedores" class="flex font-medium items-center justify-center md:justify-start text-slate-800 dark:text-slate-300">
    <% if (icon) { %>
        <div class="justify-center <%= iconColorClass %> mr-3 text-4xl">
            <div class="self-center">
                <%- icon("logo") %>
            </div>
        </div>
    <% } %>
        <span class="hidden md:flex domain text-xl md:text-2xl lg:text-3xl font-bold tracking-tight">
            <span class="<%= gradientClass %>">cheatsheets</span><span class="<%= zipColorClass %> font-black">.zip</span>
        </span>
</a>
<% if (page.layout == "note" || page._isNotePagination){ %>
    <a class="hidden md:block" href="/notes/" title="Notas - Explore nossas notas e tutoriais para desenvolvedores">
        <span class="flex items-center pl-2 ml-2 text-lg text-slate-300 md:border-l border-slate-400 dark:border-slate-700 hover:text-white transition-colors">Notas</span>
    </a>
<% } %>

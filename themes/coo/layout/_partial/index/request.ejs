<section class="text-slate-800 max-container">
    <div class=" mx-auto flex py-12 items-center justify-center flex-col">
        <span class="inline-block h-1 w-10 rounded-full bg-gradient-to-r from-indigo-500 to-purple-600 mt-8 mb-6"></span>
        <div class="text-center lg:w-2/3 w-full">
            <h3 class="sm:text-4xl text-3xl mb-4 font-medium text-slate-800 dark:text-slate-300">Sentiu falta
                de algo?</h3>
            <p class="mb-8 leading-relaxed dark:text-slate-300">
                Contribua com o código no meu repositório do GitHub<% if (theme.social_buttons) { %> ou me siga para acompanhar as cheat sheets mais recentes
                em tempo real<% } %>. É a melhor chance de participar!
            </p>
            <div class="flex flex-col md:flex-row justify-center space-x-4">
                <%- partial('_partial/buttons/github-contribute', {variant: 'request', showLabel: true}) %>
                <% if (theme.social_buttons) { %>
                <%- partial('_partial/buttons/follow-x', {variant: 'request', showLabel: true}) %>
                <% } %>
            </div>
        </div>
    </div>
</section>
<% if (page.link){ %>
    <% if (page.title){ %>
        <h1><a href="<%- page.link %>" target="_blank" title="<%= page.title || 'Link externo' %>"><%= page.title || __('no_title') %></a></h1>
    <% } else { %>
        <h1><a href="<%- page.link %>" target="_blank" title="<%= page.link || 'Link externo' %>"><%= page.link || __('no_title') %></a></h1>
    <% } %>
<% } else { %>
    <% if (false){ %>
        <h1><a href="<%- url_for(page.path) %>" title="<%= page.title || 'Título da página' %>"><%= page.title || __('no_title') %></a></h1>
    <% } else { %>
        <h1><%= page.title || __('no_title') %></h1>
    <% } %>
<% } %>

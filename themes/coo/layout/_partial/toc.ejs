<!-- Índice simples em linha do tempo -->
<% if (is_post()) { %>
<div id="toc-container" class="toc-container">
  <nav id="toc-list" class="toc-list" role="navigation" aria-label="Índice">
    <!-- Os itens do índice serão inseridos aqui pelo JavaScript -->
  </nav>
</div>

<script>
// A funcionalidade do índice será adicionada em main.js
window.addEventListener('DOMContentLoaded', function() {
  if (typeof window.initTOC === 'function') {
    window.initTOC();
  }
});
</script>
<% } %>
